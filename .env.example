# Last.fm API account. https://www.last.fm/api/account/create
# The callback URL must match LASTFM_CALLBACK_URL exactly.
# Local: http://127.0.0.1:5173/auth/lastfm/callback
# The shared secret stays on the API.
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=
LASTFM_CALLBACK_URL=http://127.0.0.1:5173/auth/lastfm/callback

FRONTEND_ORIGIN=http://127.0.0.1:5173
PORT=3001

# openssl rand -base64 32
SESSION_SECRET=
# 32 bytes, base64. openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Dedicated ENCORE database. Local: npx supabase start
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_SERVICE_ROLE_KEY=
